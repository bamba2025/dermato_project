# Copier puis remplacer les valeurs vides, ou exécuter scripts/init-env.ps1.
# Ne jamais versionner .env. Aucun mot de passe par défaut.
ENVIRONMENT=development
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
JWT_SECRET=

# Ces URLs internes sont remplacées par Compose avec les secrets de .env.
DATABASE_URL=postgresql+psycopg://derma:REPLACE_ME@postgres:5432/derma
REDIS_URL=redis://:REPLACE_ME@redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_BUCKET=derma-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000"]
MODEL_BACKBONE=mock
MODEL_PATH=/models
MEDGEMMA_ENABLED=false
GPU_DEVICE=cpu
SEED_PASSWORD=
